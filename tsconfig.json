{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "module": "NodeNext"
  },
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/api" }
  ],
  "exclude": [
    "node_modules",
    "packages/web-admin",
    "packages/web-customer",
    "packages/agent-app"
  ]
}
